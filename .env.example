# .env — copy to `.env` beside the scripts. Never commit the copy.
#
# Precedence, highest first (CLAUDE.md §3):
#     an explicit flag  ->  an exported environment variable  ->  .env  ->  default
#
# A value still carrying a {placeholder} is treated as UNSET, so a copied
# example never reaches an API as if it were a key. CLAUDE.md §17 records
# the run this rule exists to prevent: a copied example connected to a
# vendor with the literal string "{login}-zone-..." as its username and
# got a 401 a long way from its cause.
#
# `python3 env_config.py` prints what was picked up, without printing secrets.

# --- 2Captcha --------------------------------------------------------------
# One key, four separately-billed products: captcha solving, the Scraping
# Browser API, proxies and fingerprints.
#
# NOT what gets this repo in. TikTok Shop's product pages sit behind
# TikTok's own slide-puzzle challenge, and this repo does not solve that
# challenge with a key (README, "What is NOT claimed here about the
# captcha"); the access is the Scraping Browser API below. Set this only
# if you are running --fingerprint.
TWOCAPTCHA_KEY={your_2captcha_api_key}

# --- Scraping Browser API ---------------------------------------------------
# A profile's credentials live about a day, so never paste a working
# endpoint anywhere durable — this is the SHAPE, not a credential
# (CLAUDE.md §19). This is the one this repo needs: a profile that has
# already visited tiktok.com is what TikTok Shop serves (README).
#   country-  picks the exit country
#   pid-      is a profile with persistent cookies, ONE live connection each
TIKTOK_CDP_ENDPOINT=ws://{login}-zone-scraping_browser-country-us-pid-{profileId}:{password}@cb.2captcha.com:9222

# --- Proxy ------------------------------------------------------------------
# Credentials go through the driver's own fields, never onto a command line.
TIKTOK_PROXY=http://{login}-zone-resi-region-us:{password}@proxy.2captcha.com:2334

# --- Default target ---------------------------------------------------------
# A product id (19 digits) or a product URL, or a comma-separated list of
# them.
TIKTOK_URL=1732432759321694958
